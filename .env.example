# Server-only. Never use a VITE_ prefix for credentials.
# Activate only after verifying the provider plan/quota and disabling overages.
RAPIDAPI_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TAPZI_IMPORT_ACCESS_CODE=
# Your exact HTTPS origin, no trailing slash. Vercel deployment URLs are detected.
TAPZI_APP_ORIGIN=
